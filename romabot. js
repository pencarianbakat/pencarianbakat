async function surfWeb(query) {
    try {
        const ddgResp = await axios.get(`https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&no_html=1&skip_disambig=1`, { timeout: 8000, headers: { 'User-Agent': 'Mozilla/5.0' } })
        const ddg = ddgResp.data
        if (ddg.AbstractText && ddg.AbstractText.length > 50) return `🔍 *${query}*\n\n${ddg.AbstractText}\n\n📚 Sumber: ${ddg.AbstractURL || 'DuckDuckGo'}`
        if (ddg.Answer && ddg.Answer.length > 10) return `🔍 *${query}*\n\n${ddg.Answer}`
        if (ddg.RelatedTopics?.length > 0) { const topics = ddg.RelatedTopics.slice(0,3).map(t=>t.Text||'').filter(Boolean).join('\n\n'); if (topics.length > 30) return `🔍 *${query}*\n\n${topics}` }
